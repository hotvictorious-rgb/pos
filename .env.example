APP_NAME="Hysam Ventures"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file

# -------------------------------------------------------------------
# DATABASE
# -------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=hysam
DB_USERNAME=root
DB_PASSWORD=

# -------------------------------------------------------------------
# CACHE
# VPS:           redis
# Shared Hosting: file
# -------------------------------------------------------------------
CACHE_STORE=file

# -------------------------------------------------------------------
# QUEUE
# VPS:           redis (+ Supervisor for queue:work)
# Shared Hosting: sync
# -------------------------------------------------------------------
QUEUE_CONNECTION=sync

# -------------------------------------------------------------------
# SESSION
# VPS:           redis or database
# Shared Hosting: file
# -------------------------------------------------------------------
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# -------------------------------------------------------------------
# REDIS (only needed on VPS / Docker)
# -------------------------------------------------------------------
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# -------------------------------------------------------------------
# MAIL
# -------------------------------------------------------------------
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="admin@hysamventures.com"
MAIL_FROM_NAME="${APP_NAME}"

# -------------------------------------------------------------------
# LOGGING
# -------------------------------------------------------------------
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log
BCRYPT_ROUNDS=12

# -------------------------------------------------------------------
# PLATFORM SUPER-ADMIN ROOT CREDENTIALS (ENV ONLY - NEVER EXPOSE IN HTML)
# -------------------------------------------------------------------
SUPER_ADMIN_EMAIL=admin@hysamventures.com
SUPER_ADMIN_PASSWORD=changeme123
ADMIN_EMAIL=admin@hysamventures.com
ADMIN_PASSWORD=changeme123