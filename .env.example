APP_NAME="Hysam Ventures"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://yourdomain.com

# Production Deployment Lock: guarantees web installer is locked even if storage/installed is missing
APP_INSTALLED=true
APP_INSTALLER_ENABLED=false

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file

# -------------------------------------------------------------------
# DATABASE CONFIGURATION (WHOGOHOST / CPANEL MYSQL)
# -------------------------------------------------------------------
# In cPanel, go to "MySQL Databases":
# 1. Create a database (e.g. cpaneluser_pos)
# 2. Create a user (e.g. cpaneluser_dbuser) and set a strong password
# 3. Add the user to the database with ALL PRIVILEGES
# -------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=yourcpaneluser_pos
DB_USERNAME=yourcpaneluser_dbuser
DB_PASSWORD="your_cpanel_db_password"

# -------------------------------------------------------------------
# CACHE STORE
# Shared Hosting / cPanel: file
# VPS / Dedicated Server:  redis
# -------------------------------------------------------------------
CACHE_STORE=file

# -------------------------------------------------------------------
# QUEUE CONNECTION
# Shared Hosting / cPanel: sync
# VPS (with Supervisor):   redis or database
# -------------------------------------------------------------------
QUEUE_CONNECTION=sync

# -------------------------------------------------------------------
# SESSION CONFIGURATION
# Shared Hosting / cPanel: file
# VPS:                     redis or database
# -------------------------------------------------------------------
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_PATH=/
SESSION_DOMAIN=null

# -------------------------------------------------------------------
# REDIS (Only required if using Redis on a VPS)
# -------------------------------------------------------------------
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# -------------------------------------------------------------------
# MAIL CONFIGURATION (CPANEL WEBMAIL OR SMTP)
# -------------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_HOST=mail.yourdomain.com
MAIL_PORT=465
MAIL_USERNAME=admin@yourdomain.com
MAIL_PASSWORD="your_email_password"
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS="admin@yourdomain.com"
MAIL_FROM_NAME="${APP_NAME}"

# -------------------------------------------------------------------
# LOGGING
# -------------------------------------------------------------------
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log
BCRYPT_ROUNDS=12

# -------------------------------------------------------------------
# SAAS MULTI-TENANCY ENGINE
# Set to 'true' for multi-tenant isolation, 'false' for single-tenant
# -------------------------------------------------------------------
SAAS_ENABLED=true
SAAS_PLATFORM_NAME="Hysam Ventures POS"

# -------------------------------------------------------------------
# PLATFORM SUPER-ADMIN ROOT CREDENTIALS (ENV ONLY - NEVER EXPOSE IN HTML)
# Use these credentials to log in to the Master Platform Suite at /saas/login
# -------------------------------------------------------------------
SUPER_ADMIN_EMAIL=admin@hysamventures.com
SUPER_ADMIN_PASSWORD="set_your_secure_password_here"