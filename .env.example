# ===================================================================
# VM-POS / HYSAM VENTURES - ENVIRONMENT CONFIGURATION
# TAILORED FOR WHOGOHOST CPANEL SHARED HOSTING & CLOUD HOSTING
# ===================================================================

APP_NAME="Hysam Ventures"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://yourdomain.com.ng

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file

# -------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (WHOGOHOST CPANEL MYSQL)
# -------------------------------------------------------------------
# INSTRUCTIONS FOR WHOGOHOST CPANEL:
# 1. Log in to cPanel -> Click "MySQL Databases".
# 2. Under "Create New Database", enter a name (e.g. 'pos'). 
#    Your full database name will be: [cpaneluser]_[pos]
# 3. Under "MySQL Users", create a user (e.g. 'posuser') and generate a strong password.
#    Your full database username will be: [cpaneluser]_[posuser]
# 4. Under "Add User To Database", select the user & database, click "Add", 
#    and tick "ALL PRIVILEGES".
# -------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=cpaneluser_pos
DB_USERNAME=cpaneluser_posuser
DB_PASSWORD="your_cpanel_db_password"

# -------------------------------------------------------------------
# 2. SESSION & COOKIE MANAGEMENT (CRITICAL FOR MULTI-CASHIER POS)
# -------------------------------------------------------------------
# On Whogohost shared hosting:
# - Use 'database' to prevent file-locking conflicts when multiple cashiers are active.
# - Use 'file' if you prefer local storage in storage/framework/sessions.
# -------------------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_PATH=/
SESSION_DOMAIN=null

# -------------------------------------------------------------------
# 3. CACHE & PERFORMANCE (SHARED HOSTING OPTIMIZED)
# -------------------------------------------------------------------
# Whogohost Shared Hosting does not provide a dedicated Redis daemon by default.
# 'file' is the most stable and zero-config cache store for cPanel.
# -------------------------------------------------------------------
CACHE_STORE=file

# -------------------------------------------------------------------
# 4. QUEUE CONFIGURATION
# -------------------------------------------------------------------
# Whogohost Shared Hosting does not permit running persistent background daemons (Supervisor).
# 'sync' executes operations immediately in-process without needing a worker daemon.
# -------------------------------------------------------------------
QUEUE_CONNECTION=sync

# -------------------------------------------------------------------
# 5. WHOGOHOST CPANEL WEBMAIL / SMTP CONFIGURATION
# -------------------------------------------------------------------
# INSTRUCTIONS FOR WHOGOHOST EMAIL:
# 1. In cPanel, click "Email Accounts" -> "Create" (e.g. pos@yourdomain.com.ng).
# 2. Use SSL/TLS settings:
#    - SMTP Server: mail.yourdomain.com.ng (or your cPanel server hostname)
#    - Port: 465 (with ssl) or 587 (with tls)
# -------------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_HOST=mail.yourdomain.com.ng
MAIL_PORT=465
MAIL_USERNAME=pos@yourdomain.com.ng
MAIL_PASSWORD="your_cpanel_email_password"
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS="pos@yourdomain.com.ng"
MAIL_FROM_NAME="${APP_NAME}"

# -------------------------------------------------------------------
# 6. LOGGING & ERROR TRACKING (PREVENT DISK QUOTA OVERFLOW)
# -------------------------------------------------------------------
# 'daily' automatically rotates log files and prevents a single laravel.log
# from filling up your cPanel storage quota.
# -------------------------------------------------------------------
LOG_CHANNEL=daily
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log
BCRYPT_ROUNDS=12

# -------------------------------------------------------------------
# 7. MULTI-BRANCH SAAS PLATFORM CONFIGURATION
# -------------------------------------------------------------------
# Set to 'true' to enable multi-branch, multi-warehouse, and multi-tenant isolation.
# -------------------------------------------------------------------
SAAS_ENABLED=true
SAAS_PLATFORM_NAME="Hysam Ventures POS"

# -------------------------------------------------------------------
# 8. INITIAL ADMINISTRATOR PROVISIONING CREDENTIALS
# -------------------------------------------------------------------
# Used during the first 'php artisan db:seed' to create your master admin account.
# Once created, the database password hash is authoritative.
# Change passwords anytime through the web interface at /account/password.
# -------------------------------------------------------------------
SUPER_ADMIN_EMAIL=admin@hysamventures.com
SUPER_ADMIN_PASSWORD="ChooseAStrongPassword123!"